# Copy to .env.local and fill in. Never commit real values.

# Public base URL, used for canonical URLs, Open Graph, JSON-LD, passkeys
# and secure cookies (https:// turns on __Secure- cookie names).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection string. Use the pooled URL in production (Vercel).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/refurbednused

# Field encryption keys for bank details and staff TOTP secrets (AES-256-GCM).
# Comma-separated "id:base64" pairs, 32 bytes each; the first is used for new values.
# Generate with: npm run key:generate
# To rotate: put the new key first and keep old keys until data is re-encrypted.
FIELD_ENCRYPTION_KEYS=k1:REPLACE_WITH_OUTPUT_OF_npm_run_key_generate

# --- Auth.js -------------------------------------------------------------------
# Signs and encrypts auth tokens. At least 32 characters: npm run secret:generate
AUTH_SECRET=REPLACE_WITH_OUTPUT_OF_npm_run_secret_generate
# Do NOT set AUTH_URL: the customer (/api/auth) and staff (/api/staff-auth)
# instances use different base paths, and AUTH_URL would override them.

# Resend API key for magic-link emails. If unset, links are printed to the
# server console instead (development only; required on Vercel production).
AUTH_RESEND_KEY=
# Sender for sign-in emails. The domain must be verified in Resend.
EMAIL_FROM="RefurbednUsed <no-reply@example.com>"

# Google sign-in (optional; the button is hidden if unset). Create an OAuth
# client in Google Cloud and add BOTH redirect URIs:
#   <site>/api/auth/callback/google        (customers)
#   <site>/api/staff-auth/callback/google  (staff)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Media (Cloudflare R2) -------------------------------------------------------
# Public URL of the R2 bucket's custom domain, no trailing slash. Product
# photos are stored by object key and served from here. Unset: served from
# public/media (sample photos for development only).
NEXT_PUBLIC_MEDIA_BASE_URL=

# --- Bot protection (Cloudflare Turnstile) --------------------------------------
# Required in production. Unset in development/tests: the check is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- SMS (Twilio) -----------------------------------------------------------------
# Required in production. Unset: texts are printed to the server console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A UK-capable sender number (+44…) or a Messaging Service SID (MG…).
TWILIO_FROM=
