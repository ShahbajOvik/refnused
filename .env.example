# Copy to .env.local and fill in. Never commit real values.

# Public base URL, used for canonical URLs, Open Graph, JSON-LD, passkeys
# and secure cookies (https:// turns on __Secure- cookie names).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection string. Use the pooled URL in production (Vercel).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/refurbednused

# Field encryption keys for bank details and staff TOTP secrets (AES-256-GCM).
# Comma-separated "id:base64" pairs, 32 bytes each; the first is used for new values.
# Generate with: npm run key:generate
# To rotate: put the new key first and keep old keys until data is re-encrypted.
FIELD_ENCRYPTION_KEYS=k1:REPLACE_WITH_OUTPUT_OF_npm_run_key_generate

# --- Auth.js -------------------------------------------------------------------
# Signs and encrypts auth tokens. At least 32 characters: npm run secret:generate
AUTH_SECRET=REPLACE_WITH_OUTPUT_OF_npm_run_secret_generate
# Do NOT set AUTH_URL: the customer (/api/auth) and staff (/api/staff-auth)
# instances use different base paths, and AUTH_URL would override them.

# Resend API key for magic-link emails. If unset, links are printed to the
# server console instead (development only; required on Vercel production).
AUTH_RESEND_KEY=
# Sender for sign-in emails. The domain must be verified in Resend.
EMAIL_FROM="RefurbednUsed <no-reply@example.com>"

# Google sign-in (optional; the button is hidden if unset). Create an OAuth
# client in Google Cloud and add BOTH redirect URIs:
#   <site>/api/auth/callback/google        (customers)
#   <site>/api/staff-auth/callback/google  (staff)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Media (Cloudflare R2) -------------------------------------------------------
# Uploads from the admin (photos, data-wipe certificates). Two buckets: a public
# one for photos (its custom domain is NEXT_PUBLIC_MEDIA_BASE_URL) and a private
# one for certificates. Required in production. Unset: files go to .media/ locally.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET=
R2_PRIVATE_BUCKET=
# Optional local upload folder when R2 isn't configured (default ./.media).
MEDIA_LOCAL_DIR=

# --- Content (Sanity) ---------------------------------------------------------------
# Sanity Studio URL, linked from /admin/content.
SANITY_STUDIO_URL=
# Sanity project for /guides (schema in sanity/schemaTypes). Unset: only the
# built-in guides (model prices, wiping a phone, grading) are shown.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Pinned API version (a date). Leave as is unless you've tested a newer one.
SANITY_API_VERSION=2025-02-19
# Viewer token, only needed if the dataset is private.
SANITY_API_READ_TOKEN=
# Secret for the Sanity webhook (GROQ-powered, on publish/unpublish/delete of
# guide and author documents) that calls <site>/api/revalidate/sanity.
# At least 16 characters: npm run secret:generate
SANITY_REVALIDATE_SECRET=

# Public URL of the R2 bucket's custom domain, no trailing slash. Product
# photos are stored by object key and served from here. Unset: served from
# public/media (sample photos for development only).
NEXT_PUBLIC_MEDIA_BASE_URL=

# --- Payments (Stripe) ------------------------------------------------------------
# Required in production (live keys). Use test keys (sk_test_/pk_test_) everywhere
# else. Unset: checkout uses a stand-in gateway and shows no payment form
# (development and tests only).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook endpoint <site>/api/stripe/webhook. Locally:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# Events: payment_intent.succeeded, payment_intent.processing,
# payment_intent.payment_failed, payment_intent.canceled, charge.refunded
STRIPE_WEBHOOK_SECRET=

# --- Bot protection (Cloudflare Turnstile) --------------------------------------
# Required in production. Unset in development/tests: the check is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- SMS (Twilio) -----------------------------------------------------------------
# Required in production. Unset: texts are printed to the server console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A UK-capable sender number (+44…) or a Messaging Service SID (MG…).
TWILIO_FROM=

# --- Web Push (VAPID) ---------------------------------------------------------------
# Quote, order and price-alert notifications. Generate with: npm run push:keys
# Set both keys, or neither (unset: the "turn on notifications" buttons are hidden).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services about our messages (mailto: or https:). Required in production.
VAPID_SUBJECT=mailto:support@example.com

# --- Error reporting (Sentry) ------------------------------------------------------
# Unset: no error reporting. Events are scrubbed of personal data before sending
# (src/lib/observability/scrub.ts). The DSN is public by design.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for uploading source maps (deleted from the build after upload).
# Keep the token in Vercel's environment variables, never in the repo.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
