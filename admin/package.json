{
  "name": "admin",
  "version": "0.1.0",
  "private": true,
  "description": "RefurbednUsed staff admin (its own Next.js app and Vercel project).",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "security:secrets": "node ../refnused/scripts/check-client-secrets.mjs",
    "staff:create": "node --import tsx --import @refnused/database/config/load-env scripts/staff-create.mts",
    "staff:set-password": "node --import tsx --import @refnused/database/config/load-env scripts/staff-set-password.mts",
    "db:seed:owner": "node --import tsx --import @refnused/database/config/load-env scripts/seed-owner.mts",
    "staff:list": "node --import tsx --import @refnused/database/config/load-env scripts/staff-list.mts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@next/env": "16.4.6",
    "@refnused/database": "*",
    "@sentry/nextjs": "11.10.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
