{
  "name": "@refnused/database",
  "version": "0.1.0",
  "private": true,
  "description": "Shared database schema, migrations and business logic for the RefurbednUsed website and admin.",
  "exports": {
    "./db": "./src/db/index.ts",
    "./db/schema": "./src/db/schema/index.ts",
    "./db/seed": "./src/db/seed/index.ts",
    "./lib/payments": "./src/lib/payments/index.ts",
    "./lib/storage": "./src/lib/storage/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file-if-exists=../.env.local --import tsx scripts/db-seed.mts",
    "db:test-snapshot": "node --conditions=react-server --import tsx scripts/create-test-db.mts",
    "key:generate": "node -e \"console.log('k1:' + require('node:crypto').randomBytes(32).toString('base64'))\"",
    "secret:generate": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64url'))\"",
    "push:keys": "node -e \"const k=require('web-push').generateVAPIDKeys();console.log('NEXT_PUBLIC_VAPID_PUBLIC_KEY='+k.publicKey+'\\nVAPID_PRIVATE_KEY='+k.privateKey)\"",
    "db:e2e-server": "node --conditions=react-server --import tsx scripts/e2e-postgres.mts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.1",
    "server-only": "^0.0.1",
    "stripe": "^23.1.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "next": "16.4.6"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "0.2.19",
    "@types/node": "^22.20.5",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "17.11.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
