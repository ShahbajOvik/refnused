{
  "name": "refnused-monorepo",
  "private": true,
  "workspaces": [
    "database",
    "refnused",
    "admin"
  ],
  "scripts": {
    "dev": "npm run dev -w refnused --",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w refnused --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "test:e2e": "playwright test",
    "audit": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=high",
    "db:generate": "npm run db:generate -w @refnused/database",
    "db:migrate": "npm run db:migrate -w @refnused/database",
    "db:seed": "npm run db:seed -w @refnused/database --",
    "db:studio": "npm run db:studio -w @refnused/database",
    "key:generate": "npm run key:generate -w @refnused/database",
    "secret:generate": "npm run secret:generate -w @refnused/database",
    "push:keys": "npm run push:keys -w @refnused/database",
    "dev:admin": "npm run dev -w admin --",
    "start:admin": "npm run start -w admin --",
    "staff:create": "npm run staff:create -w admin --",
    "staff:set-password": "npm run staff:set-password -w admin --",
    "db:e2e-server": "npm run db:e2e-server -w @refnused/database",
    "db:dev-server": "npm run db:dev-server -w @refnused/database",
    "db:seed:owner": "npm run db:seed:owner -w admin"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "engines": {
    "node": ">=22"
  }
}
